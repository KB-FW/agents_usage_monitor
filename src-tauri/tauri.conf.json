{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentPets",
  "version": "0.1.0",
  "identifier": "dev.agentpets.usage-monitor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "AI 에이전트 사용량 모니터 겸 데스크톱 펫",
    "longDescription": "Claude Code, Codex, Gemini CLI, Grok 사용량을 데스크톱 펫과 함께 보여주는 모니터",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
